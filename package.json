{
  "name": "fofbiomass",
  "description": "FoFBiomass: geospatial mapping of SPAM2020 crop production across all crops",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "colormap": "^2.3.2",
    "ol": "^10.7.0"
  },
  "eslintConfig": {
    "extends": "openlayers",
    "rules": {
      "no-unused-vars": [
        "error",
        {
          "varsIgnorePattern": "^map"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint main.js",
    "test": "npm run lint",
    "start": "vite serve",
    "build": "vite build",
    "dev": "vite",
    "deploy": "vite build && netlify deploy --prod --dir dist --site 4defc561-4922-47b5-bd57-41708771051b"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-openlayers": "^19.0.0",
    "netlify-cli": "^17.38.1",
    "vite": "^7.2.2"
  }
}
